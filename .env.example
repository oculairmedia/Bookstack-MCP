# BookStack API connection (required)
BS_URL=https://your-bookstack.example.com
BS_TOKEN_ID=your_token_id_here
BS_TOKEN_SECRET=your_token_secret_here

# Server configuration (optional)
PORT=3054

# Optional: HTTP client tuning
# BS_HTTP_RETRIES=3
# BS_HTTP_BACKOFF=0.5
# BS_HTTP_POOL_SIZE=10
# BS_HTTP_TIMEOUT=60          # read timeout for GET requests (seconds)
# BS_HTTP_WRITE_TIMEOUT=120   # base timeout for POST/PUT/DELETE; scales with payload size
# BS_HTTP_FORM_TIMEOUT=120    # timeout for multipart/image uploads

# Optional: cache TTLs in seconds
# BS_CACHE_BOOKS_TTL=600
# BS_CACHE_PAGES_TTL=300
# BS_CACHE_IMAGES_TTL=900
# BS_CACHE_SEARCH_TTL=180

# Optional: enable semantic search by pointing at a Hayhooks endpoint
# HAYHOOKS_SEARCH_URL=http://hayhooks:1416/search_documents/run
